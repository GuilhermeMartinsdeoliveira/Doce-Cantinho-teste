@model DoceCantinho.Application.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="page active" id="page-home">

    <!-- ─── Hero ─── -->
    <section class="hero">

        <div class="hero-bg">
            <img src="https://images.unsplash.com/photo-1486427944299-d1955d23e34d?w=1600&h=900&fit=crop&auto=format"
                 alt="Confeitaria artesanal" loading="eager" />
            <div class="hero-overlay"></div>
        </div>

        <div class="container hero-content">
            <div>
                <span class="hero-badge">Artesanal • Feito com Amor</span>
                <h1 class="hero-title">Feito com <em>amor</em>,<br>entregue com carinho</h1>
                <p class="hero-desc">
                    Confeitaria artesanal com 12 anos de tradição. Criamos momentos doces
                    para celebrar cada ocasião especial da sua vida.
                </p>
                <div class="hero-btns">
                    <a asp-controller="Doces" asp-action="Index" class="btn btn-accent">
                        Ver Produtos
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </a>
                    <a asp-controller="Home" asp-action="Contato" class="btn btn-ghost">Fazer Encomenda</a>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-n">500+</div>
                    <div class="stat-label">Clientes felizes</div>
                </div>
                <div class="stat-card">
                    <div class="stat-n">12</div>
                    <div class="stat-label">Anos de tradição</div>
                </div>
                <div class="stat-card">
                    <div class="stat-n">@Model.Categories.Count()</div>
                    <div class="stat-label">Categorias</div>
                </div>
                <div class="stat-card">
                    <div class="stat-n">★ 5.0</div>
                    <div class="stat-label">Avaliação média</div>
                </div>
            </div>
        </div>

    </section>

    <!-- ─── Produtos em Destaque ─── -->
    <section class="section-featured">
        <div class="container">
            <div class="section-header-row">
                <div>
                    <p class="section-eyebrow">Destaques</p>
                    <h2 class="section-title">Nossos Queridinhos</h2>
                </div>
                <a asp-controller="Doces" asp-action="Index" class="see-all-link">
                    Ver todos
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            </div>

            @if (Model.FeaturedDoce.Any())
            {
                <div class="products-grid">
                    @foreach (var doce in Model.FeaturedDoce.Take(4))
                    {
                        <div class="product-card">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(doce.CoverImageUrl))
                                {
                                    <img src="@doce.CoverImageUrl" alt="@doce.Title" class="product-img" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <polyline points="21 15 16 10 5 21" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="product-body">
                                @if (!string.IsNullOrEmpty(doce.CategoryName))
                                {
                                    <p class="product-cat">@doce.CategoryName</p>
                                }
                                <h3 class="product-name">@doce.Title</h3>
                                <p class="product-desc">@doce.Description</p>
                                <div class="product-footer">
                                    <span class="product-price">@doce.Preco.ToString("C")</span>
                                    <a asp-controller="Doces" asp-action="Details" asp-route-id="@doce.Id"
                                       class="btn btn-accent btn-sm">Ver</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (Model.RecentDoce.Any())
            {
                <!-- Fallback: mostra recentes se não houver destaques cadastrados -->
                <div class="products-grid">
                    @foreach (var doce in Model.RecentDoce.Take(4))
                    {
                        <div class="product-card">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(doce.CoverImageUrl))
                                {
                                    <img src="@doce.CoverImageUrl" alt="@doce.Title" class="product-img" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <polyline points="21 15 16 10 5 21" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="product-body">
                                @if (!string.IsNullOrEmpty(doce.CategoryName))
                                {
                                    <p class="product-cat">@doce.CategoryName</p>
                                }
                                <h3 class="product-name">@doce.Title</h3>
                                <p class="product-desc">@doce.Description</p>
                                <div class="product-footer">
                                    <span class="product-price">@doce.Preco.ToString("C")</span>
                                    <a asp-controller="Doces" asp-action="Details" asp-route-id="@doce.Id"
                                       class="btn btn-accent btn-sm">Ver</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="text-align:center;color:var(--muted-fg);padding:3rem 0">
                    Nenhum produto em destaque cadastrado ainda.
                </p>
            }

        </div>
    </section>

    <!-- ─── Categorias ─── -->
    @if (Model.Categories.Any())
    {
        <section class="section-services">
            <div class="container">
                <div style="text-align:center;margin-bottom:2.5rem">
                    <p class="section-eyebrow">Explore</p>
                    <h2 class="section-title">Nossas Categorias</h2>
                </div>
                <div class="services-grid">
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-controller="Doces" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="service-card" style="text-decoration:none;cursor:pointer">
                            <div class="service-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                </svg>
                            </div>
                            <h3 class="service-name">@cat.Name</h3>
                            <p class="service-desc">@cat.DoceCount produto@(cat.DoceCount != 1 ? "s" : "")</p>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ─── Depoimentos ─── -->
    <section class="section-testimonials">
        <div class="container">
            <div style="text-align:center;margin-bottom:2.5rem">
                <p class="section-eyebrow">Depoimentos</p>
                <h2 class="section-title light">O que dizem nossos clientes</h2>
            </div>
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">"O bolo de casamento foi simplesmente perfeito. Todos os convidados adoraram!"</p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">A</div>
                        <div>
                            <p class="testimonial-name">Ana Oliveira</p>
                            <p class="testimonial-role">Noiva</p>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">"Encomendei para o aniversário da minha filha e ela ficou encantada. Qualidade incrível!"</p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">M</div>
                        <div>
                            <p class="testimonial-name">Maria Santos</p>
                            <p class="testimonial-role">Cliente fiel</p>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">"Os macarons são os melhores que já comi. Recomendo de olhos fechados!"</p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">C</div>
                        <div>
                            <p class="testimonial-name">Carlos Mendes</p>
                            <p class="testimonial-role">Cliente</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ─── CTA ─── -->
    <section class="section-cta">
        <div class="container">
            <div class="cta-box">
                <p class="section-eyebrow" style="color:var(--accent)">Pronto para adoçar?</p>
                <h2 class="section-title serif" style="margin-bottom:1rem">Faça seu pedido hoje</h2>
                <p style="color:var(--muted-fg);margin-bottom:2rem">Encomende com antecedência e garanta seu doce especial.</p>
                <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
                    <a asp-controller="Doces" asp-action="Index" class="btn btn-primary">Ver produtos</a>
                    <a asp-controller="Home" asp-action="Contato" class="btn btn-outline">Falar conosco</a>
                </div>
            </div>
        </div>
    </section>

</div>
