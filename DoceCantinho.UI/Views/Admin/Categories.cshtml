    @using DoceCantinho.Application.DTOs
@model IEnumerable<CategoryDto>

<style>
    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .data-table thead {
        background: var(--primary);
        color: var(--primary-fg);
    }

    .data-table th {
        padding: 1rem;
        text-align: left;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
    }

    .data-table td {
        padding: 1rem;
        border-top: 1px solid var(--border);
    }

    .data-table tbody tr:hover {
        background: rgba(92, 46, 14, 0.03);
    }

    .data-table tbody tr:last-child td {
        border-bottom: none;
    }

    .category-actions {
        display: flex;
        gap: 0.75rem;
    }

    .category-actions a {
        padding: 0.55rem 1rem;
        border-radius: calc(var(--radius) - 0.25rem);
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        transition: all 0.2s ease;
        border: 2px solid;
        text-decoration: none;
        display: inline-block;
    }

    .category-actions a:first-child {
        background: var(--primary);
        color: var(--primary-fg);
        border-color: var(--primary);
    }

    .category-actions a:first-child:hover {
        background: #4a2309;
        border-color: #4a2309;
        box-shadow: 0 4px 12px rgba(92, 46, 14, 0.25);
    }

    .category-actions a:last-child {
        background: transparent;
        color: var(--accent);
        border-color: var(--accent);
    }

    .category-actions a:last-child:hover {
        background: var(--accent);
        color: var(--accent-fg);
        box-shadow: 0 4px 12px rgba(212, 112, 74, 0.25);
    }
</style>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.Name</td>
                        <td>
                            <div class="category-actions">
                                <a asp-action="EditCategory" asp-route-id="@cat.Id">
                                    ✎ Editar
                                </a>
                                <a asp-action="DeleteCategory" asp-route-id="@cat.Id">
                                    🗑 Deletar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
