@using DoceCantinho.Application.DTOs
@model IEnumerable<CategoryDto>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.Name</td>
                        <td>
                            <a asp-action="DeleteCategory" asp-route-id="@cat.Id"
                               class="btn btn-outline btn-sm" style="color:#dc2626;border-color:#dc2626">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
