@model CarrinhoSessao

@{
    ViewData["Title"] = "Carrinho de Compras";
}

<style>
    .carrinho-container {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .carrinho-header {
        margin-bottom: 2rem;
    }

    .carrinho-header h1 {
        font-family: 'Playfair Display', serif;
        color: var(--primary);
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .carrinho-vazio {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--card);
        border-radius: var(--radius);
        border: 2px dashed var(--border);
    }

    .carrinho-vazio svg {
        width: 80px;
        height: 80px;
        color: var(--muted-fg);
        margin-bottom: 1rem;
    }

    .carrinho-vazio p {
        color: var(--muted-fg);
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
    }

    .carrinho-grid {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 2rem;
        margin-bottom: 2rem;
    }

  
    

    .carrinho-items {
        background: var(--card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .carrinho-item {
        display: flex;
        gap: 1rem;
        padding: 1.5rem;
        border-bottom: 1px solid var(--border);
        align-items: flex-start;
    }

    .carrinho-item:last-child {
        border-bottom: none;
    }

    .item-img {
        width: 100px;
        height: 100px;
        background: var(--bg);
        border-radius: calc(var(--radius) - 0.25rem);
        overflow: hidden;
        flex-shrink: 0;
    }

    .item-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-details {
        flex: 1;
    }

    .item-name {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 0.25rem;
    }

    .item-price {
        color: var(--primary);
        font-size: 0.95rem;
        margin-bottom: 0.75rem;
    }

    .item-quantity {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .item-quantity button {
        width: 28px;
        height: 28px;
        border: 1px solid var(--border);
        background: var(--bg);
        border-radius: calc(var(--radius) - 0.5rem);
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
        color: var(--fg);
    }

    .item-quantity button:hover {
        background: var(--primary);
        color: var(--primary-fg);
        border-color: var(--primary);
    }

    .item-quantity input {
        width: 50px;
        text-align: center;
        border: 1px solid var(--border);
        padding: 0.25rem;
        border-radius: calc(var(--radius) - 0.5rem);
    }

    .item-subtotal {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--primary);
    }

    .item-remove {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .item-remove form {
        display: inline;
    }

    .btn-remove {
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
        background: #fecaca;
        color: #991b1b;
        border: none;
        border-radius: calc(var(--radius) - 0.5rem);
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
    }

    .btn-remove:hover {
        background: #fca5a5;
    }

    .carrinho-sidebar {
        background: var(--card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 1.5rem;
        height: fit-content;
        position: sticky;
        top: 1rem;
    }

    .sidebar-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--fg);
        margin-bottom: 1.5rem;
    }

    .resumo-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
        color: var(--muted-fg);
        font-size: 0.95rem;
    }

    .resumo-total {
        display: flex;
        justify-content: space-between;
        padding-top: 1rem;
        border-top: 2px solid var(--border);
        margin-bottom: 1.5rem;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary);
    }

    .form-dados {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .form-dados input,
    .form-dados textarea {
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) - 0.25rem);
        font-family: 'Nunito', sans-serif;
        font-size: 0.95rem;
    }

    .form-dados input:focus,
    .form-dados textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(92, 46, 14, 0.1);
    }

    .form-dados label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--fg);
    }

    .btn-finalizar {
        width: 100%;
        padding: 0.85rem;
        background: var(--primary);
        color: var(--primary-fg);
        border: none;
        border-radius: calc(var(--radius) - 0.25rem);
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        margin-bottom: 0.75rem;
    }

    .btn-finalizar:hover {
        background: #4a2309;
        box-shadow: 0 4px 12px rgba(92, 46, 14, 0.25);
    }

    .btn-finalizar:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-continuar-comprando {
        width: 100%;
        padding: 0.85rem;
        background: transparent;
        color: var(--primary);
        border: 2px solid var(--primary);
        border-radius: calc(var(--radius) - 0.25rem);
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        text-align: center;
        display: block;
    }

    .btn-continuar-comprando:hover {
        background: var(--primary);
        color: var(--primary-fg);
    }

    .btn-limpar {
        width: 100%;
        padding: 0.75rem;
        background: #fecaca;
        color: #991b1b;
        border: none;
        border-radius: calc(var(--radius) - 0.25rem);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 0.75rem;
    }

    .btn-limpar:hover {
        background: #fca5a5;
    }

    .aviso {
        padding: 1rem;
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        border-radius: calc(var(--radius) - 0.25rem);
        color: #92400e;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }
</style>

<div class="carrinho-container">
    <div class="carrinho-header">
        <h1>🛒 Carrinho de Compras</h1>
    </div>

    @if (Model?.Itens == null || !Model.Itens.Any())
    {
        <div class="carrinho-vazio">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <p>Seu carrinho está vazio 😢</p>
            <a asp-controller="Doces" asp-action="Index" class="btn-continuar-comprando">
                ← Continuar Comprando
            </a>
        </div>
    }
    else
    {
        <div class="carrinho-grid">
            <!-- Itens do carrinho -->
            <div class="carrinho-items">
                @foreach (var item in Model.Itens)
                {
                    <div class="carrinho-item">
                        <div class="item-img">
                            @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" alt="@item.Nome" />
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; background: var(--bg); display: flex; align-items: center; justify-content: center; color: var(--muted-fg);">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30">
                                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                </div>
                            }
                        </div>

                        <div class="item-details">
                            <div class="item-name">@item.Nome</div>
                            <div class="item-price">R$ @item.Preco.ToString("F2")</div>

                            <div class="item-quantity">
                                <form asp-action="AtualizarQuantidade" method="post" style="display: inline;">
                                    <input type="hidden" name="doceId" value="@item.DoceId" />
                                    <button type="submit" name="quantidade" value="@(item.Quantidade - 1)">−</button>
                                </form>
                                <span style="min-width: 50px; text-align: center; font-weight: 600;">@item.Quantidade</span>
                                <form asp-action="AtualizarQuantidade" method="post" style="display: inline;">
                                    <input type="hidden" name="doceId" value="@item.DoceId" />
                                    <button type="submit" name="quantidade" value="@(item.Quantidade + 1)">+</button>
                                </form>
                            </div>

                            <div class="item-subtotal">
                                R$ @(item.Preco * item.Quantidade).ToString("F2")
                            </div>

                            <div class="item-remove">
                                <form asp-action="Remover" method="post">
                                    <input type="hidden" name="doceId" value="@item.DoceId" />
                                    <button type="submit" class="btn-remove">
                                        🗑 Remover
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Resumo e checkout -->
            <div class="carrinho-sidebar">
                <div class="sidebar-title">Resumo do Pedido</div>

                <div class="resumo-item">
                    <span>Subtotal:</span>
                    <span>R$ @Model.Total.ToString("F2")</span>
                </div>
                <div class="resumo-item">
                    <span>Itens:</span>
                    <span>@Model.QuantidadeTotal</span>
                </div>

                <div class="resumo-total">
                    <span>Total:</span>
                    <span>R$ @Model.Total.ToString("F2")</span>
                </div>

                <div class="aviso">
                    ℹ Você será redirecionado para o WhatsApp para confirmar seu pedido.
                </div>

                <form asp-action="FinalizarCompra" method="post" class="form-dados">
                    @Html.AntiForgeryToken()

                    <div>
                        <label for="nomeCliente">👤 Seu Nome *</label>
                        <input type="text" id="nomeCliente" name="nomeCliente" required placeholder="Seu nome completo" />
                    </div>

                    <div>
                        <label for="telefone">📱 WhatsApp *</label>
                        <input type="tel" id="telefone" name="telefone" required placeholder="(11) 99999-9999" pattern="\([0-9]{2}\) [0-9]{4,5}-[0-9]{4}" />
                    </div>

                    <div>
                        <label for="endereco">📍 Endereço (opcional)</label>
                        <textarea id="endereco" name="endereco" placeholder="Rua, número, bairro..." rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn-finalizar">
                        ✓ Finalizar no WhatsApp
                    </button>
                </form>

                <a asp-controller="Doces" asp-action="Index" class="btn-continuar-comprando">
                    ← Continuar Comprando
                </a>

                <form asp-action="Limpar" method="post">
                    <button type="submit" class="btn-limpar">
                        🗑 Limpar Carrinho
                    </button>
                </form>
            </div>
        </div>
    }
</div>
